From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Port D6300 <port@example.org>
Date: Fri, 20 Nov 2026 15:30:00 +0300
Subject: [PATCH] bmips: bcm6362: add Netgear D6300 image

Add the image recipe for the Netgear D6300:
- 16 KB blocks / 512 B pages, matching the ST NAND512W3A2CN6
- cferam from bcm63xx-cfe (netgear,d6300/cferam)
- 496k cferam JFFS2 padding (multiple of the 16 KB erase block)
- CFE_WFI_FLASH_TYPE 2 (16 KB blocks) and version 0x5731
- USB 2.0, b43 (2.4 GHz) and GPIO LED packages

---
diff --git a/target/linux/bmips/image/bcm6362.mk b/target/linux/bmips/image/bcm6362.mk
index f2ff5c7..0a5c924 100644
--- a/target/linux/bmips/image/bcm6362.mk
+++ b/target/linux/bmips/image/bcm6362.mk
@@ -40,3 +40,21 @@
   CFE_WFI_VERSION := 0x5731
 endef
 TARGET_DEVICES += netgear_dgnd3700-v2
+
+define Device/netgear_d6300
+  $(Device/bcm63xx-nand)
+  DEVICE_VENDOR := NETGEAR
+  DEVICE_MODEL := D6300
+  CHIP_ID := 6362
+  CFE_RAM_FILE := netgear,d6300/cferam.000
+  CFE_RAM_JFFS2_NAME := cferam.000
+  CFE_RAM_JFFS2_PAD := 496k
+  BLOCKSIZE := 16k
+  PAGESIZE := 512
+  DEVICE_PACKAGES += $(USB2_PACKAGES) \
+    $(B43_PACKAGES) \
+    kmod-leds-bcm6328 kmod-leds-gpio
+  CFE_WFI_FLASH_TYPE := 2
+  CFE_WFI_VERSION := 0x5731
+endef
+TARGET_DEVICES += netgear_d6300

-- 
